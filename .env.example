# ===== Frontend (Vite) =====
# Endpoint GraphQL do projeto Hasura Cloud (valor público — vai para o bundle).
VITE_HASURA_GRAPHQL_ENDPOINT=https://SEU-PROJETO.hasura.app/v1/graphql

# Opcional em dev local: base das funções de auth (/api/login, /api/signup).
# Em produção fica vazio (mesmo domínio da Vercel). Em `npm run dev` local,
# aponte para o deploy da Vercel para não precisar rodar as funções localmente.
VITE_API_BASE=

# ===== Funções serverless (Vercel — configurar no painel da Vercel) =====
# Endpoint GraphQL do Hasura (o mesmo de cima).
HASURA_ENDPOINT=https://SEU-PROJETO.hasura.app/v1/graphql
# Admin secret do Hasura Cloud (Settings -> Env vars -> HASURA_GRAPHQL_ADMIN_SECRET).
HASURA_ADMIN_SECRET=
# Chave usada para assinar os JWTs de sessão. Precisa ser IDÊNTICA ao campo
# "key" do HASURA_GRAPHQL_JWT_SECRET configurado no Hasura. Mínimo 32 chars.
JWT_SECRET=
